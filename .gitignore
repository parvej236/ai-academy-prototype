# ------------------------------------------------------------------
# AI Academy — repository-wide ignores
# Per-app rules live in each app folder (e.g. frontend/.gitignore).
# ------------------------------------------------------------------

# Dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Build output
.next/
out/
build/
dist/
*.tsbuildinfo

# Environment and secrets — commit only the *.example templates
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.crt
credentials*.json
secrets/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test output and coverage
coverage/
.nyc_output/
playwright-report/
test-results/
.playwright-mcp/

# Python (for the backend, when it is added)
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Local data and uploads
*.sqlite
*.sqlite3
*.db
uploads/
media/

# Editors and tools
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
.claude/settings.local.json

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Deploy tooling
.vercel
.turbo
